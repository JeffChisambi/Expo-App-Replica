{
  "name": "stem-smartstudy",
  "version": "1.0.0",
  "packageManager": "pnpm@10.26.1",
  "license": "MIT",
  "scripts": {
    "dev:backend": "pnpm --filter @stem-smartstudy/api dev",
    "dev:api": "pnpm run dev:backend",
    "dev:mobile": "pnpm --filter @stem-smartstudy/mobile start",
    "dev:mobile:go": "pnpm --filter @stem-smartstudy/mobile start -- --go --clear",
    "dev:web-preview": "pnpm --filter @stem-smartstudy/web-preview dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/**\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
